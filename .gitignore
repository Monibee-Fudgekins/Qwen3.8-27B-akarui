# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Kaggle
.kaggle/
kaggle.json
*.ipynb_checkpoints/
.ipynb_checkpoints

# Packaged kernel directories are build artifacts, rebuilt by
# scripts/package_kernel.py / scripts/package_eval_kernel.py at trigger
# time; they carry a copy of data/train.jsonl, which is pushed
# separately. The READMEs in kernels/sft/ and kernels/eval/ are the
# exception: they are committed as documentation.
kernels/*
!kernels/sft/
kernels/sft/*
!kernels/sft/README.md
!kernels/eval/
kernels/eval/*
!kernels/eval/README.md

# Training outputs and checkpoints (large; never commit)
output/
checkpoints/
*.ckpt
*.safetensors
runs/

# Datasets: raw training files are generated, not committed.
# Manifests under data/manifests/ ARE committed (provenance).
data/*.jsonl
data/*.csv
data/*.parquet

# Secrets and local environment
.env
*.env
*.pem
*.key

# Editors / OS
.DS_Store
.vscode/
.idea/
